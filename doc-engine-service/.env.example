# Chuoi ket noi Postgres (Neon). De trong thi API luu vao file JSON va dung bai mau co san.
# Lay o Neon Console > Connection Details, bat Pooled connection.
DATABASE_URL=

# Tai khoan admin, tao hoac cap nhat moi lan khoi dong API. Mat khau toi thieu 8 ky tu.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Chi dung khi chuyen sang database moi (vi du doi vung Neon): dat database CU o day, database MOI o
# DATABASE_URL, roi chay "npm run db:copy". Xong viec thi xoa dong nay.
# SOURCE_DATABASE_URL=

# Khoa ky phien dang nhap, toi thieu 32 ky tu ngau nhien. Khong dat thi dung khoa tam va
# moi phien dang nhap mat khi khoi dong lai. Tao nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Dat true khi chay sau HTTPS de cookie dang nhap chi gui qua ket noi an toan.
# COOKIE_SECURE=true

# Gioi han so request moi dia chi IP trong mot cua so (mac dinh 120 request / 60 giay).
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60
# Dat khi chay sau reverse proxy de dem dung IP nguoi dung, vi du TRUST_PROXY=1
# TRUST_PROXY=1

PORT=3000
# CORS_ORIGIN=http://localhost:4200
